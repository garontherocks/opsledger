FROM postgres:18.6 AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential postgresql-server-dev-18 ca-certificates curl \
    && curl --fail --location https://codeload.github.com/pgvector/pgvector/tar.gz/refs/tags/v0.8.7 -o /tmp/vector.tar.gz \
    && echo 'cac0b10c360f05b2d521200105ba3697e773d4cd3731f5a915a7e37ebe0bea85  /tmp/vector.tar.gz' | sha256sum -c - \
    && mkdir /tmp/vector && tar -xzf /tmp/vector.tar.gz -C /tmp/vector --strip-components=1 \
    && make -C /tmp/vector OPTFLAGS='' && make -C /tmp/vector install
FROM postgres:18.6
COPY --from=build /usr/lib/postgresql/18/lib/vector.so /usr/lib/postgresql/18/lib/vector.so
COPY --from=build /usr/share/postgresql/18/extension/vector* /usr/share/postgresql/18/extension/
