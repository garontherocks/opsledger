# Generate your own secrets; these placeholders deliberately cannot start the app.
DATABASE_URL=postgresql://opsledger:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/opsledger
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
BASE_URL=http://localhost:3100
PORT=3100
NODE_ENV=development
LAB_MODE=true

# Choose an absolute private directory, shared by API and worker; never inside web dist.
STORAGE_DIR=/REPLACE_WITH_ABSOLUTE_PRIVATE_STORAGE_DIRECTORY
# Optional worker-only database credential; use restricted credentials outside the local lab.
# JOB_DATABASE_URL=postgresql://opsledger_worker:REPLACE_JOB_PASSWORD@127.0.0.1:5432/opsledger
# Explicitly set LAB_DB_BACKEND=pglite only for the optional PGlite harness.

# Server-derived capabilities; changes require process restart.
READ_ONLY=false
KNOWLEDGE_ENABLED=true
ASYNC_ENABLED=true

# Phase 6: synthetic lab only, off by default. Restart API after changes.
AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b-q4_K_M
# Copy the full installed manifest digest and prefix sha256: when needed.
# OLLAMA_DIGEST=sha256:<64-lowercase-hex>
AI_TIMEOUT_MS=30000
# Start the local runtime separately with OLLAMA_NO_CLOUD=1 and loopback binding.

# Phase 8 optional semantic search: lab only, independent from generation.
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=embeddinggemma:300m
# EMBEDDING_DIGEST=sha256:<full-installed-manifest-digest>
