{
  "name": "opsledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "lint": "eslint apps packages tests scripts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "start": "node --experimental-strip-types apps/api/src/server.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed:lab": "node --experimental-strip-types scripts/seed.ts",
    "test:unit": "node --experimental-strip-types --test tests/domain.test.ts tests/lifecycle.domain.test.ts tests/knowledge.domain.test.ts tests/async.domain.test.ts tests/client.unit.test.ts tests/local-model.unit.test.ts tests/structured-output.unit.test.ts tests/embeddings.unit.test.ts tests/qa-agent.unit.test.ts",
    "test:integration": "node --experimental-strip-types scripts/integration-runner.ts",
    "test:e2e": "node --experimental-strip-types scripts/browser-runner.ts",
    "db:lab": "node --experimental-strip-types scripts/lab-db.ts",
    "worker": "node --experimental-strip-types apps/api/src/worker.ts",
    "quality:baseline": "node --experimental-strip-types scripts/quality-baseline.ts",
    "ai:pilot": "node --experimental-strip-types scripts/local-ai-pilot.ts",
    "ai:live-smoke": "node --experimental-strip-types scripts/live-summary-smoke.ts",
    "ai:eval": "node --experimental-strip-types scripts/phase7-eval.ts",
    "ai:structured-pilot": "node --env-file=.env --experimental-strip-types scripts/phase7-live-pilot.ts",
    "ai:regression": "node --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/phase10-eval.ts",
    "ai:m2-desktop": "node --env-file=.env --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/m2-desktop.ts",
    "ai:m2-harness": "node --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/m2-desktop.ts",
    "agent:eval": "node --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/phase11-eval.ts",
    "agent:live": "node --env-file=.env --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/phase11-live.ts",
    "mcp:server": "node --import ./scripts/mcp-egress.mjs --experimental-strip-types scripts/qa-mcp-server.ts",
    "mcp:test": "node --import ./scripts/mcp-egress.mjs --experimental-strip-types --test tests/qa-mcp.integration.test.ts",
    "m3:test": "node --import ./scripts/m3-egress.ts --experimental-strip-types --test tests/qa-m3.integration.test.ts",
    "m4:context-test": "node --import ./scripts/mcp-egress.mjs --experimental-strip-types --test tests/qa-context.unit.test.ts",
    "m4:state-test": "node --experimental-strip-types --test tests/qa-state.integration.test.ts",
    "m4:workflow-test": "node --experimental-strip-types --test --test-concurrency=1 tests/qa-workflow.integration.test.ts tests/qa-crash.integration.test.ts tests/qa-api.integration.test.ts tests/qa-runner.integration.test.ts",
    "ai:m4-desktop": "node --env-file=.env --import ./scripts/m3-egress.ts --experimental-strip-types scripts/m4-desktop.ts",
    "ai:m4-harness": "node --import ./scripts/m3-egress.ts --experimental-strip-types scripts/m4-desktop.ts",
    "ai:m3-desktop": "node --env-file=.env --import ./scripts/m3-egress.ts --experimental-strip-types scripts/m3-desktop.ts",
    "m5:orchestration-test": "node --experimental-strip-types --test tests/qa-orchestration.integration.test.ts",
    "m5:n8n-smoke": "node --experimental-strip-types scripts/phase17-n8n.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "pg-boss": "12.37.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "promptfoo": "0.116.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "basic-ftp": "6.2.2",
    "promptfoo": {
      "csv-parse": "7.0.2",
      "fast-xml-parser": "5.7.0",
      "mathjs": "15.2.0",
      "sharp": "0.35.5",
      "tmp": "0.2.7",
      "uuid": "11.1.1"
    },
    "drizzle-orm": "$drizzle-orm"
  }
}
