{
  "name": "opsledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "lint": "eslint apps packages tests scripts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "start": "node --experimental-strip-types apps/api/src/server.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed:lab": "node --experimental-strip-types scripts/seed.ts",
    "test:unit": "node --experimental-strip-types --test tests/domain.test.ts tests/lifecycle.domain.test.ts tests/knowledge.domain.test.ts tests/async.domain.test.ts tests/client.unit.test.ts tests/local-model.unit.test.ts",
    "test:integration": "node --experimental-strip-types scripts/integration-runner.ts",
    "test:e2e": "node --experimental-strip-types scripts/browser-runner.ts",
    "db:lab": "node --experimental-strip-types scripts/lab-db.ts",
    "worker": "node --experimental-strip-types apps/api/src/worker.ts",
    "quality:baseline": "node --experimental-strip-types scripts/quality-baseline.ts",
    "ai:pilot": "node --experimental-strip-types scripts/local-ai-pilot.ts",
    "ai:live-smoke": "node --experimental-strip-types scripts/live-summary-smoke.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@fastify/swagger": "9.9.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "pg-boss": "12.37.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
