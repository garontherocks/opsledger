{
  "name": "opsledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "lint": "eslint apps packages tests scripts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "start": "node --experimental-strip-types apps/api/src/server.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed:lab": "node --experimental-strip-types scripts/seed.ts",
    "test:unit": "node --experimental-strip-types --test tests/domain.test.ts tests/lifecycle.domain.test.ts tests/knowledge.domain.test.ts tests/async.domain.test.ts tests/client.unit.test.ts tests/local-model.unit.test.ts tests/structured-output.unit.test.ts tests/embeddings.unit.test.ts tests/qa-agent.unit.test.ts tests/agent-tracing.unit.test.ts tests/model-contrast.unit.test.ts tests/audit-gate.unit.test.ts tests/run-feed.unit.test.ts tests/retrieval-golden.unit.test.ts",
    "test:integration": "node --experimental-strip-types scripts/integration-runner.ts",
    "test:e2e": "node --experimental-strip-types scripts/browser-runner.ts",
    "db:lab": "node --experimental-strip-types scripts/lab-db.ts",
    "worker": "node --experimental-strip-types apps/api/src/worker.ts",
    "quality:baseline": "node --experimental-strip-types scripts/quality-baseline.ts",
    "ai:pilot": "node --experimental-strip-types scripts/local-ai-pilot.ts",
    "ai:live-smoke": "node --experimental-strip-types scripts/live-summary-smoke.ts",
    "ai:eval": "node --experimental-strip-types scripts/phase7-eval.ts",
    "ai:structured-pilot": "node --env-file=.env --experimental-strip-types scripts/phase7-live-pilot.ts",
    "ai:regression": "node --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/phase10-eval.ts",
    "ai:m2-desktop": "node --env-file=.env --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/m2-desktop.ts",
    "ai:m2-harness": "node --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/m2-desktop.ts",
    "agent:eval": "node --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/phase11-eval.ts",
    "agent:live": "node --env-file=.env --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/phase11-live.ts",
    "mcp:server": "node --import ./scripts/mcp-egress.mjs --experimental-strip-types scripts/qa-mcp-server.ts",
    "mcp:test": "node --import ./scripts/mcp-egress.mjs --experimental-strip-types --test tests/qa-mcp.integration.test.ts",
    "m3:test": "node --import ./scripts/m3-egress.ts --experimental-strip-types --test tests/qa-m3.integration.test.ts",
    "m4:context-test": "node --import ./scripts/mcp-egress.mjs --experimental-strip-types --test tests/qa-context.unit.test.ts",
    "m4:state-test": "node --experimental-strip-types --test tests/qa-state.integration.test.ts",
    "m4:workflow-test": "node --experimental-strip-types --test --test-concurrency=1 tests/qa-workflow.integration.test.ts tests/qa-crash.integration.test.ts tests/qa-api.integration.test.ts tests/qa-runner.integration.test.ts",
    "ai:m4-desktop": "node --env-file=.env --import ./scripts/m3-egress.ts --experimental-strip-types scripts/m4-desktop.ts",
    "ai:m4-harness": "node --import ./scripts/m3-egress.ts --experimental-strip-types scripts/m4-desktop.ts",
    "ai:m3-desktop": "node --env-file=.env --import ./scripts/m3-egress.ts --experimental-strip-types scripts/m3-desktop.ts",
    "m5:orchestration-test": "node --experimental-strip-types --test tests/qa-orchestration.integration.test.ts",
    "m5:n8n-smoke": "node --experimental-strip-types scripts/phase17-n8n.ts",
    "m5:specialist-test": "node --experimental-strip-types --test tests/qa-specialists.unit.test.ts",
    "m5:specialist-fixture": "M5_BUNDLE_FIXTURE=true node --import ./scripts/m3-egress.ts --experimental-strip-types scripts/phase18-comparison.ts",
    "m5:specialist-desktop": "node --env-file=.env --import ./scripts/m3-egress.ts --experimental-strip-types scripts/phase18-comparison.ts",
    "m5:pipeline-test": "node --experimental-strip-types --test tests/qa-pipeline.unit.test.ts",
    "m5:pipeline-smoke": "node --experimental-strip-types scripts/phase19-smoke.ts",
    "m5:desktop": "node --env-file=.env --experimental-strip-types scripts/m5-desktop.ts",
    "rag:golden": "node --experimental-strip-types --test tests/retrieval-golden.integration.test.ts",
    "rag:golden:record": "node --env-file=.env --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/retrieval-golden/record.ts",
    "contrast:record": "node --env-file=.env --import ./scripts/eval-egress.mjs --experimental-strip-types scripts/model-contrast/record.ts",
    "contrast:report": "node --experimental-strip-types scripts/model-contrast/report.ts",
    "contrast:test": "node --experimental-strip-types --test tests/model-contrast.unit.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.16",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "1.10.0",
    "better-auth": "1.7.16",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-pgvector": "0.0.16",
    "@electric-sql/pglite-socket": "0.2.18",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "promptfoo": "0.116.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "basic-ftp": "6.2.2",
    "promptfoo": {
      "csv-parse": "7.0.2",
      "fast-xml-parser": "5.7.0",
      "mathjs": "15.2.0",
      "sharp": "0.35.5",
      "tmp": "0.2.7",
      "uuid": "11.1.1",
      "mongoose": "9.11.4"
    },
    "drizzle-orm": "$drizzle-orm",
    "@modelcontextprotocol/node": {
      "@hono/node-server": "2.1.6"
    },
    "playwright": "$@playwright/test",
    "playwright-core": "$@playwright/test"
  }
}
